# Similar to Tor Browser, we use a new file (different than the brand.ftl file
# that is used by Firefox) to avoid picking up the -brand-short-name values
# that Mozilla includes in the Firefox language packs.

-brand-shorter-name = Ceno
-brand-short-name = Ceno
-brand-shortcut-name = Ceno
-brand-full-name = Ceno
# This brand name can be used in messages where the product name needs to
# remain unchanged across different versions (Nightly, Beta, etc.).
-brand-product-name = Ceno
-vendor-short-name = eQualitie
trademarkInfo = { " " }
