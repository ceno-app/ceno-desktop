!insertmacro MUI_LANGUAGE "English" ; Always available

LangString LAUNCH_TEXT ${LANG_ENGLISH} "&Launch ${BrandFullName} now"

LangString WARN_MIN_SUPPORTED_OSVER_MSG ${LANG_ENGLISH} "Sorry, ${BrandFullName} can’t be installed. This version of ${BrandFullName} requires ${MinSupportedVer} or newer. Please click the OK button for additional information."
LangString WARN_MIN_SUPPORTED_CPU_MSG ${LANG_ENGLISH} "Sorry, ${BrandFullName} can’t be installed. This version of ${BrandFullName} requires a processor with ${MinSupportedCPU} support. Please click the OK button for additional information."
LangString WARN_MIN_SUPPORTED_OSVER_CPU_MSG ${LANG_ENGLISH} "Sorry, ${BrandFullName} can’t be installed. This version of ${BrandFullName} requires ${MinSupportedVer} or newer and a processor with ${MinSupportedCPU} support. Please click the OK button for additional information."

LangString add_shortcuts ${LANG_ENGLISH} "&Add Start menu and desktop icons"
LangString destination_exists ${LANG_ENGLISH} "The destination folder already exists. Do you want to continue anyway?"

LangString uninstall_readme ${LANG_ENGLISH} "Delete entire ${BrandFullName} directory and shortcuts to uninstall."
