include $(topsrcdir)/config/rules.mk

# Define Ouinet download path
OUINET_OUTPUT_DIR = $(OBJDIR)/dist/bin/ouinet/build

# Target for downloading Ouinet files
download-ouinet:
	@echo "Downloading Ouinet files..."
	@mkdir -p $(OUINET_OUTPUT_DIR)
	@cd $(DIST)/bin/ouinet && $(PYTHON3) download_ouinet.py $(OUINET_OUTPUT_DIR)
