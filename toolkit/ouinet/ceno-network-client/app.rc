#include "Resource.h"
#include <winuser.h>
#include <windows.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "ceno-network-client.manifest.xml"

IDI_ICON_ACTIVE ICON "ceno.ico"
IDI_ICON_GRAY   ICON "cenogray.ico"

STRINGTABLE
BEGIN
    IDS_TOOLTIP_CONNECTING  "Ceno Network Client - Connecting"
    IDS_TOOLTIP_DEGRADED    "Ceno Network Client - Connection Degraded"
    IDS_TOOLTIP_CONNECTED   "Ceno Network Client"
    IDS_TOOLTIP_EXITING     "Ceno Network Client - Exiting"
    IDS_TOOLTIP_RESTARTING  "Ceno Network Client - Restarting"
    IDS_TOOLTIP_OFFLINE     "Ceno Network Client - Offline - Local Cache Only"
END

IDC_CONTEXTMENU MENU
BEGIN
    POPUP ""
	BEGIN
	MENUITEM "Open Ceno Browser", IDM_OPEN
	MENUITEM SEPARATOR
	MENUITEM "Disconnect from Ceno Network", IDM_EXIT
	END
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // English (US), Unicode
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Ceno Network Client"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "Ouinet"
            VALUE "OriginalFilename", "ceno-network-client.exe"
            VALUE "ProductName",      "Ceno Network Client"
            VALUE "ProductVersion",   "1.0.0"
            VALUE "LegalCopyright",   "(C) 2026 eQualitie"
            VALUE "CompanyName",      "eQualitie"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        // English (US), Unicode
        VALUE "Translation", 0x409, 1200
    END
END