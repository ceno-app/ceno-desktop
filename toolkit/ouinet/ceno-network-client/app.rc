#include "Resource.h"
#include "winuser.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "ceno-network-client.manifest.xml"

IDI_ICON_ACTIVE ICON "ceno.ico"
IDI_ICON_GRAY   ICON "cenogray.ico"

STRINGTABLE
BEGIN
    IDS_TOOLTIP_CONNECTING  "Ceno Network Client - Connecting"
    IDS_TOOLTIP_DEGRADED    "Ceno Network Client - Connection Degraded"
    IDS_TOOLTIP_CONNECTED   "Ceno Network Client"
    IDS_TOOLTIP_EXITING     "Ceno Network Client - Exiting"
    IDS_TOOLTIP_RESTARTING  "Ceno Network Client - Restarting"
    IDS_TOOLTIP_OFFLINE     "Ceno Network Client - Offline - Local Cache Only"
END

IDC_CONTEXTMENU MENU
BEGIN
    POPUP ""
	BEGIN
	MENUITEM "Open Ceno Browser", IDM_OPEN
	MENUITEM SEPARATOR
	MENUITEM "Disconnect from Ceno Network", IDM_EXIT
	END
END
