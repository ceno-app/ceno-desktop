. $topsrcdir/browser/config/mozconfigs/ceno-release

ac_add_options --with-redist

ac_add_options --target=x86_64-w64-mingw32
ac_add_options --with-toolchain-prefix=x86_64-w64-mingw32-

ac_add_options --enable-strip

# Bits is Background Intelligent Transfer Service
ac_add_options --disable-bits-download
ac_add_options --disable-maintenance-service

# See bug #13379
ac_add_options --enable-nss-mar

# See bug #41131
ac_add_options --disable-update-agent

# Bug 1782837: Not supported because Mozilla (and therefore also us) build
# libc++ with LIBCXX_ENABLE_FILESYSTEM disabled.
ac_add_options --disable-notification-server

# Let's make sure no preference is enabling either Adobe's or Google's CDM.
ac_add_options --disable-eme

# tor-browser#320: Temporarily disable until we resolve the mingw problems.
ac_add_options --disable-default-browser-agent

ac_add_options --with-base-browser-version=dev-build

ac_add_options --with-l10n-base="$topsrcdir/firefox-l10n"

ac_add_options --disable-artifact-builds

###############################
# Tor/Ceno build differences. #
# From [Tor Wiki](https://gitlab.torproject.org/tpo/applications/wiki/-/wikis/Development-Information/Tor-Browser/Windows-dev-builds)
# LLVM/Clang do not provide a C runtime, it can either use Microsoft's CRT (the one included with MSVC) or mingw.
# Mozilla uses the former, we (Tor) use the latter. (End of quote)
#
# We (Ceno) use base-browser sources provided by Tor project, but build using mozilla-build, instead of Tor's RBM
# This means we are building with Rust 1.86-x86_64-pc-windows-msvc,
# while Tor would probably use 1.86-x86_64-pc-windows-gnu .
# Amongst other good things, MSVC's C Runtime headers contain `#define max(a,b) (((a) > (b)) ? (a) : (b))`,
# which build breaks `std::numeric_limits<T>::max()`.
export CXXFLAGS="-DNOMINMAX=1"

#######################################
# Code Signing Variables and Defaults #
#######################################

# mk_add_options SIGNING_MODE=none
# SIGNING_MODE defaults to none
# autosign: sign automatically during "./mach package". autosign mode will automatically generate a self signed certificate if SIGNING_CERTIFICATE_PFX is unset or set to a non existing file.
# airgap: pause build process during "./mach package" with a prompt to sign manually. Signed files are timestamped from this machine.
# none: skip binary signing.

# Unset to remove timestamping of signed binaries
export SIGNING_TIMESTAMP_URL=http://timestamp.digicert.com

# export SIGNING_CERTIFICATE_PFX=/c/code/private.pfx
# SIGNING_CERTIFICATE_PFX defaults to obj-x86_64-w64-mingw32/dist/certs/private.pfx
# If certificate is not available on disk, one will be auto generated.

